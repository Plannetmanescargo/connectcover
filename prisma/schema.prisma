generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // PgBouncer/runtime connection
  directUrl = env("DIRECT_URL") // Direct connection for migrations
}

enum PolicyStatus {
  DRAFT
  PAID
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  SQUARE
  WORLDPAY
  MOLLIE
  PAYPAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CheckoutStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum DocumentKind {
  PROPOSAL
  CERTIFICATE
  TERMS
}

enum StorageProvider {
  SUPABASE
  R2
}

enum PolicyEventType {
  POLICY_CREATED
  PAYMENT_CONFIRMED
  DOCS_GENERATED
  EMAIL_SENT
  FINALIZE_RETRIED
  NEWSLETTER_CONTACT_ADDED
  WELCOME_AUTOMATION_TRIGGERED
}

model Policy {
  id           String       @id @default(cuid())
  policyNumber String       @unique
  status       PolicyStatus @default(DRAFT)

  // Quote details
  vrm              String
  make             String?
  model            String?
  year             String?
  startAt          DateTime
  endAt            DateTime
  durationMs       BigInt
  totalAmountPence Int

  // Customer
  fullName    String
  dob         DateTime
  email       String
  licenceType String
  address     String

  // Payment
  paymentProvider PaymentProvider
  paymentId       String
  paymentStatus   PaymentStatus
  currency        String

  // Legacy Stripe-only reference.
  // Keep nullable so existing records and Stripe projects remain compatible.
  stripePaymentIntentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents PolicyDocument[]
  events    PolicyEvent[]

  @@unique([paymentProvider, paymentId])
  @@index([email])
  @@index([vrm])
  @@index([startAt])
}

model PaymentCheckout {
  id     String         @id @default(cuid())
  brand  String
  status CheckoutStatus @default(PENDING)

  // Quote details
  vrm              String
  make             String?
  model            String?
  year             String?
  startAt          DateTime
  endAt            DateTime
  durationMs       BigInt
  totalAmountPence Int

  // Customer details
  fullName    String
  dob         DateTime
  email       String
  licenceType String
  address     String

  // Payment configuration
  paymentProvider PaymentProvider
  currency        String          @default("GBP")

  // Stripe hosted Checkout, bound to the original configuration and attempt.
  stripeRequestKey String? @unique
  stripeRequestHash String?
  stripeConfigHash String?
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId String? @unique
  stripeCheckoutUrl String?
  stripeLivemode Boolean?
  stripeProcessingUntil DateTime?
  stripeFulfilledAt DateTime?
  stripeNextAttemptAt DateTime?
  stripeReviewReason String?

  // Square references
  squarePaymentLinkId String? @unique
  squareOrderId       String? @unique
  squarePaymentId     String? @unique

  // Worldpay references and a bounded lease for webhook retries.
  worldpayTransactionReference String? @unique
  worldpayPaymentId String? @unique
  worldpayEntity String?
  worldpayEnvironment String?
  worldpayProcessingUntil DateTime?
  worldpayFulfilledAt DateTime?
  worldpayQueryAfter DateTime?

  // Mollie checkout recovery and a lease shared by webhook/status/cron workers.
  mollieRequestKey String? @unique
  mollieConfigHash String?
  mollieRequestHash String?
  molliePaymentId String? @unique
  mollieMode String?
  mollieProfileId String?
  mollieCheckoutUrl String?
  mollieProcessingUntil DateTime?
  mollieFulfilledAt DateTime?
  mollieNextAttemptAt DateTime?
  mollieReviewReason String?

  // PayPal Orders v2 identity and durable recovery.
  paypalRequestKey String? @unique
  paypalRequestHash String?
  paypalOrderId String? @unique
  paypalCaptureId String? @unique
  paypalMode String?
  paypalMerchantId String?
  paypalConfigHash String?
  paypalCaptureStartedAt DateTime?
  paypalProcessingUntil DateTime?
  paypalFulfilledAt DateTime?
  paypalNextAttemptAt DateTime?
  paypalReviewReason String?

  // Policy created after successful payment
  policyId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentProvider, mollieNextAttemptAt])
  @@index([paymentProvider, paypalNextAttemptAt])
  @@index([paymentProvider, stripeNextAttemptAt])
  @@index([brand])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model PolicyDocument {
  id       String @id @default(cuid())
  policyId String
  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  kind     DocumentKind
  filename String

  storageProvider StorageProvider @default(SUPABASE)
  storageKey      String?
  url             String?

  createdAt DateTime @default(now())

  @@index([policyId])
  @@index([kind])
}

model PolicyEvent {
  id       String @id @default(cuid())
  policyId String
  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  type      PolicyEventType
  data      Json?
  createdAt DateTime        @default(now())

  @@index([policyId])
  @@index([type])
}

// Minimal authenticated payment event; no card/customer payloads are retained.
model WorldpayJob {
  id String @id
  environment String
  event Json
  createdAt DateTime @default(now())
  completedAt DateTime?
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  attempts Int @default(0)
  lastError String?
  @@index([completedAt, nextAttemptAt])
}
