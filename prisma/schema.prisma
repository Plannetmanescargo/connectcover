generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // PgBouncer/runtime connection
  directUrl = env("DIRECT_URL") // Direct connection for migrations
}

enum PolicyStatus {
  DRAFT
  PAID
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  SQUARE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CheckoutStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum DocumentKind {
  PROPOSAL
  CERTIFICATE
  TERMS
}

enum StorageProvider {
  SUPABASE
  R2
}

enum PolicyEventType {
  POLICY_CREATED
  PAYMENT_CONFIRMED
  DOCS_GENERATED
  EMAIL_SENT
  FINALIZE_RETRIED
  NEWSLETTER_CONTACT_ADDED
  WELCOME_AUTOMATION_TRIGGERED
}

model Policy {
  id           String       @id @default(cuid())
  policyNumber String       @unique
  status       PolicyStatus @default(DRAFT)

  // Quote details
  vrm              String
  make             String?
  model            String?
  year             String?
  startAt          DateTime
  endAt            DateTime
  durationMs       BigInt
  totalAmountPence Int

  // Customer
  fullName    String
  dob         DateTime
  email       String
  licenceType String
  address     String

  // Payment
  paymentProvider PaymentProvider
  paymentId       String
  paymentStatus   PaymentStatus
  currency        String

  // Legacy Stripe-only reference.
  // Keep nullable so existing records and Stripe projects remain compatible.
  stripePaymentIntentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents PolicyDocument[]
  events    PolicyEvent[]

  @@unique([paymentProvider, paymentId])
  @@index([email])
  @@index([vrm])
  @@index([startAt])
}

model PaymentCheckout {
  id     String         @id @default(cuid())
  brand  String
  status CheckoutStatus @default(PENDING)

  // Quote details
  vrm              String
  make             String?
  model            String?
  year             String?
  startAt          DateTime
  endAt            DateTime
  durationMs       BigInt
  totalAmountPence Int

  // Customer details
  fullName    String
  dob         DateTime
  email       String
  licenceType String
  address     String

  // Payment configuration
  paymentProvider PaymentProvider
  currency        String          @default("GBP")

  // Square references
  squarePaymentLinkId String? @unique
  squareOrderId       String? @unique
  squarePaymentId     String? @unique

  // Policy created after successful payment
  policyId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand])
  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model PolicyDocument {
  id       String @id @default(cuid())
  policyId String
  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  kind     DocumentKind
  filename String

  storageProvider StorageProvider @default(SUPABASE)
  storageKey      String?
  url             String?

  createdAt DateTime @default(now())

  @@index([policyId])
  @@index([kind])
}

model PolicyEvent {
  id       String @id @default(cuid())
  policyId String
  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  type      PolicyEventType
  data      Json?
  createdAt DateTime        @default(now())

  @@index([policyId])
  @@index([type])
}
